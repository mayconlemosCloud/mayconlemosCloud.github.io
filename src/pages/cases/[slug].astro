---
import Base from '../../layouts/Base.astro';
import { cases, type Case } from '../../data/cases';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };
const idx = cases.findIndex((x) => x.slug === c.slug);
const proximo = cases[(idx + 1) % cases.length];
---

<Base title={`${c.titulo} · Maycon Lemos`} description={c.resumo}>
  <article class="wrap case-page">
    <a href="/#cases" class="voltar">← Todos os cases</a>

    <header class="case-header">
      <p class="eyebrow">Case {c.numero}</p>
      <h1 class="display">{c.titulo}</h1>
      <p class="lead">{c.resumo}</p>
      <div class="stack">
        {c.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
      <div class="links">
        <a class="link-arrow" href={c.repo} target="_blank" rel="noopener">Código no GitHub →</a>
        {
          c.demo && (
            <a class="link-arrow" href={c.demo} target="_blank" rel="noopener">
              Vídeo da demonstração →
            </a>
          )
        }
      </div>
    </header>

    {
      c.resultados && (
        <section class="bloco">
          <h2>Resultados</h2>
          <div class="metricas">
            {c.resultados.map((r) => (
              <div>
                <span class="metrica-valor">{r.valor}</span>
                <span class="metrica-rotulo">{r.rotulo}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="bloco">
      <h2>O problema</h2>
      <p>{c.problema}</p>
    </section>

    <section class="bloco">
      <h2>Arquitetura</h2>
      <ul>
        {c.arquitetura.map((a) => <li>{a}</li>)}
      </ul>
    </section>

    <section class="bloco">
      <h2>Decisões e trade-offs</h2>
      <div class="decisoes">
        {
          c.decisoes.map((d) => (
            <div>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bloco">
      <h2>O que aprendi e o que faria diferente</h2>
      <ul>
        {c.aprendizados.map((a) => <li>{a}</li>)}
      </ul>
    </section>

    <a href={`/cases/${proximo.slug}/`} class="proximo">
      <span class="eyebrow">Próximo case</span>
      <span class="display proximo-title">{proximo.titulo} →</span>
    </a>
  </article>
</Base>

<style>
  .case-page {
    max-width: 820px;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .voltar {
    font-size: 15px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .case-header {
    margin: 40px 0 64px;
  }
  .case-header h1 {
    font-size: clamp(34px, 5vw, 56px);
  }
  .lead {
    font-size: 20px;
    color: var(--ink-soft);
    margin: 24px 0;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 28px;
  }
  .bloco {
    border-top: 1px solid var(--line);
    padding: 40px 0;
  }
  .bloco h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    margin: 0 0 20px;
  }
  .bloco p,
  .bloco li {
    color: var(--ink-soft);
  }
  .bloco ul {
    padding-left: 20px;
    margin: 0;
  }
  .bloco li {
    margin-bottom: 10px;
  }
  .decisoes {
    display: grid;
    gap: 28px;
  }
  .decisoes h3 {
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .decisoes p {
    margin: 0;
  }
  .metricas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
  }
  .metricas div {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    display: grid;
  }
  .metrica-valor {
    font-family: var(--font-display);
    font-size: 34px;
  }
  .metrica-rotulo {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .proximo {
    display: grid;
    gap: 4px;
    margin-top: 24px;
    padding: 32px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .proximo .eyebrow {
    margin: 0;
  }
  .proximo-title {
    font-size: 26px;
  }
  .proximo:hover .proximo-title {
    color: var(--accent);
  }
</style>
