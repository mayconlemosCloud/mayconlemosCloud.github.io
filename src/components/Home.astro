---
import Base from '../layouts/Base.astro';
import { getCases } from '../data/cases';
import { ui, links, localize, chips, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const cases = getCases(lang);
---

<Base lang={lang} path="/" title={t.meta.title} description={t.meta.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 class="display hero-title">{t.hero.titulo}</h1>
        <p class="hero-sub">{t.hero.sub}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#cases">{t.hero.verCases}</a>
          <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={links.github} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="photo-block" aria-hidden="true"></div>
        <img
          src="/fotos/cena1-bracos-cruzados-bege.webp"
          alt={t.hero.fotoAlt}
          width="559"
          height="1050"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section" id="video">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.video.eyebrow}</p>
        <h2 class="display">{t.video.titulo}</h2>
      </div>
      <div class="video-wrap">
        <video controls preload="none" playsinline poster="/video/apresentacao-poster.jpg">
          <source src="/video/apresentacao.mp4" type="video/mp4" />
        </video>
      </div>
      <p class="video-nota">{t.video.nota}</p>
    </div>
  </section>

  <section class="section" id="cases">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.cases.eyebrow}</p>
        <h2 class="display">{t.cases.titulo}</h2>
      </div>
      <ol class="cases">
        {
          cases.map((c) => (
            <li class="case">
              <a href={localize(`/cases/${c.slug}/`, lang)} class="case-link">
                <span class="case-num">{c.numero}</span>
                <div class="case-body">
                  <h3 class="display case-title">{c.titulo}</h3>
                  <p class="case-resumo">{c.resumo}</p>
                  <div class="case-stack">
                    {c.stack.map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                </div>
                <span class="case-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="experiencia">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.experiencia.eyebrow}</p>
        <h2 class="display">{t.experiencia.titulo}</h2>
      </div>
      <ol class="exp">
        {
          t.experiencia.itens.map((e) => (
            <li>
              <span class="exp-periodo">{e.periodo}</span>
              <div>
                <h3 class="exp-empresa">{e.empresa}</h3>
                <p class="exp-cargo">{e.cargo}</p>
                <p class="exp-texto">{e.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="como-trabalho">
    <div class="wrap split">
      <div class="split-photo">
        <div class="photo-block small" aria-hidden="true"></div>
        <img src="/fotos/cena6-notebook.webp" alt={t.comoTrabalho.fotoAlt} width="907" height="1076" loading="lazy" />
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">{t.comoTrabalho.eyebrow}</p>
          <h2 class="display">{t.comoTrabalho.titulo}</h2>
        </div>
        <div class="principios">
          {
            t.comoTrabalho.principios.map((p) => (
              <article>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="sobre">
    <div class="wrap split reverse">
      <div>
        <div class="section-head">
          <p class="eyebrow">{t.sobre.eyebrow}</p>
          <h2 class="display">{t.sobre.titulo}</h2>
        </div>
        <div class="prose">
          {t.sobre.paragrafos.map((p) => <p>{p}</p>)}
        </div>
        <div class="case-stack">
          {chips.map((c) => <span class="chip">{c}</span>)}
        </div>
      </div>
      <div class="split-photo">
        <div class="photo-block small" aria-hidden="true"></div>
        <img src="/fotos/cena3-jeans-sereno.webp" alt={t.sobre.fotoAlt} width="738" height="1030" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section" id="agora">
    <div class="wrap split">
      <div class="split-photo">
        <div class="photo-block small" aria-hidden="true"></div>
        <img src="/fotos/cena5-tablet.webp" alt={t.agora.fotoAlt} width="923" height="1042" loading="lazy" />
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">{t.agora.eyebrow}</p>
          <h2 class="display">{t.agora.titulo}</h2>
        </div>
        <dl class="agora">
          {
            t.agora.itens.map((a) => (
              <div>
                <dt>{a.rotulo}</dt>
                <dd>{a.texto}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section contato" id="contato">
    <div class="wrap">
      <p class="eyebrow">{t.contato.eyebrow}</p>
      <h2 class="display contato-title">{t.contato.titulo}</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href={links.linkedin} target="_blank" rel="noopener">{t.contato.linkedin}</a>
        <a class="btn" href={links.github} target="_blank" rel="noopener">{t.contato.github}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(32px, 6vw, 72px) 0 0;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    min-height: calc(100svh - 64px - clamp(32px, 6vw, 72px));
  }
  .hero-text {
    align-self: center;
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .hero-title {
    font-size: clamp(34px, min(4.6vw, 7.4vh), 64px);
  }
  .hero-sub {
    font-size: 19px;
    color: var(--ink-soft);
    max-width: 34em;
    margin: 28px 0 0;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
  }
  .btn:hover {
    border-color: var(--ink-muted);
  }
  .btn-primary {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .btn-primary:hover {
    opacity: 0.88;
  }

  .hero-photo,
  .split-photo {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .hero-photo img {
    position: relative;
    width: auto;
    max-width: 100%;
    height: min(78vh, 720px);
    object-fit: contain;
    object-position: bottom;
  }
  .photo-block {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 72%;
    background: var(--photo-bg);
    border-radius: 32px 32px 0 0;
  }
  .photo-block.small {
    border-radius: 28px 28px 0 0;
    height: 78%;
  }
  .split-photo img {
    position: relative;
    width: auto;
    max-width: 100%;
    height: min(64vh, 540px);
    object-fit: contain;
    object-position: bottom;
  }

  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .case {
    border-bottom: 1px solid var(--line);
  }
  .case-link {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 40px;
    gap: 24px;
    padding: 40px 0;
    text-decoration: none;
    align-items: start;
  }
  .case-num {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--ink-muted);
  }
  .case-title {
    font-size: clamp(24px, 3vw, 34px);
    transition: color 0.2s;
  }
  .case-resumo {
    color: var(--ink-soft);
    max-width: 44em;
    margin: 12px 0 18px;
  }
  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .case-arrow {
    font-size: 28px;
    color: var(--ink-muted);
    transition: transform 0.2s, color 0.2s;
  }
  .case-link:hover .case-title,
  .case-link:hover .case-arrow {
    color: var(--accent);
  }
  .case-link:hover .case-arrow {
    transform: translateX(6px);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .split.reverse {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }
  .principios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 40px;
  }
  .principios h3 {
    font-size: 18px;
    font-weight: 500;
    margin: 0 0 8px;
  }
  .principios p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 16px;
  }
  .prose p {
    color: var(--ink-soft);
    margin: 0 0 16px;
    max-width: 38em;
  }

  .agora {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .agora div {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .agora dt {
    color: var(--ink-muted);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 2px;
  }
  .agora dd {
    margin: 0;
  }

  .contato-title {
    font-size: clamp(32px, 5vw, 60px);
    max-width: 18em;
  }

  .video-wrap {
    border-radius: 24px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
  }
  .video-wrap video {
    width: 100%;
    height: 100%;
    display: block;
  }
  .video-nota {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--ink-muted);
  }

  .exp {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .exp li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .exp-periodo {
    color: var(--ink-muted);
    font-size: 15px;
    padding-top: 4px;
  }
  .exp-empresa {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 28px);
    margin: 0;
    font-weight: 400;
  }
  .exp-cargo {
    margin: 4px 0 10px;
    font-weight: 500;
    font-size: 15px;
  }
  .exp-texto {
    margin: 0;
    color: var(--ink-soft);
    max-width: 46em;
  }

  @media (max-width: 860px) {
    .exp li {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .hero-grid,
    .split,
    .split.reverse {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-grid {
      min-height: 0;
    }
    .hero-text {
      padding-bottom: 0;
    }
    .hero-photo img {
      height: min(60vh, 460px);
    }
    .split-photo {
      order: -1;
    }
    .split-photo img {
      height: min(52vh, 380px);
    }
    .principios {
      grid-template-columns: minmax(0, 1fr);
    }
    .case-link {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 32px 0;
    }
    .case-arrow {
      display: none;
    }
    .agora div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
